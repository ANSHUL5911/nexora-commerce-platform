# ==============================================================================
# Nexora Backend Environment Configuration Example
# ==============================================================================
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES.
# NEVER COMMIT THE ACTUAL .env FILE OR ANY REAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION RUNTIME
# ------------------------------------------------------------------------------
# Allowed values: development | test | production
NODE_ENV=development
PORT=5000

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Development / Test / Production database credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexora_dev
DB_USER=nexora_user
DB_PASSWORD=your_secure_db_password_here
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Direct connection URI (Precedence: DATABASE_URL takes priority over discrete variables)
# If DATABASE_URL is set, it will be used instead of DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD.
# DATABASE_URL=postgresql://nexora_user:your_secure_db_password_here@localhost:5432/nexora_dev

# ------------------------------------------------------------------------------
# REVERSE PROXY & CLIENT IP RESOLUTION
# ------------------------------------------------------------------------------
# Configures Express 'trust proxy' setting for secure client IP detection.
# Only safe documented values are accepted:
# - Number of trusted reverse proxy hops (e.g., '1' for single ALB/Nginx/Render proxy, '2' for Cloudflare + ALB)
# - Predefined subnet aliases: 'loopback', 'linklocal', 'uniquelocal'
# - Specific trusted IP address or CIDR subnet (e.g., '127.0.0.1', '10.0.0.0/8')
# - 'false' or empty to disable (default: socket peer IP is authoritative)
# NEVER set to arbitrary values or trust arbitrary forwarding headers from untrusted clients.
TRUST_PROXY=

# ------------------------------------------------------------------------------
# SECURITY & SESSION MANAGEMENT
# ------------------------------------------------------------------------------
# Application session entropy secret (sessions use opaque 256-bit CSPRNG identifiers in PostgreSQL; cookie is unsigned)
SESSION_SECRET=replace_with_a_secure_random_32_character_string_for_sessions
SESSION_MAX_AGE_MS=86400000
# Set to 'true' in production (requires HTTPS), 'false' in local development
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Reserved entropy string (guest tokens use pure SHA-256 hashing at rest without HMAC secret)
GUEST_TOKEN_SECRET=replace_with_a_secure_random_32_character_string_for_tokens
GUEST_TOKEN_EXPIRY_DAYS=30

# ------------------------------------------------------------------------------
# CORS & FRONTEND CLIENT
# ------------------------------------------------------------------------------
# Origin allowed to make credentialed requests
# Development: http://localhost:5173
# Production: https://your-production-domain.com
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY (Razorpay Test / Live Mode)
# ------------------------------------------------------------------------------
# Test mode keys start with 'rzp_test_', live mode keys start with 'rzp_live_'
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# RATE LIMITING & SECURITY
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_GENERAL=100
RATE_LIMIT_MAX_AUTH=5
RATE_LIMIT_MAX_CHECKOUT=10
RATE_LIMIT_MAX_GUEST=15
