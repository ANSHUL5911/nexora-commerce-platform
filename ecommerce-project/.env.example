# ==============================================================================
# Nexora Frontend Environment Configuration Example
# ==============================================================================
# COPY THIS FILE TO .env.local AND FILL IN YOUR VALUES.
# NEVER COMMIT REAL SECRETS. VITE EXPOSES ALL 'VITE_' VARIABLES TO THE BROWSER.
# ==============================================================================

# Backend API Base URL
# Development (with Vite proxy): /api
# Production or standalone: https://api.your-production-domain.com/api
VITE_API_BASE_URL=/api

# Razorpay Public Key ID (Required for frontend Razorpay modal checkout)
# Development/Test Mode: rzp_test_...
# Production: rzp_live_...
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
