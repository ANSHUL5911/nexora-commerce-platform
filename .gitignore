*.sqlite
*.sqlite3
*.db

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Temporary files
tmp/
temp/

# Certificates / private keys
*.pem
*.key
*.p12
*.pfx

# Local tooling / cache
.npm/
.eslintcache
.cache/


